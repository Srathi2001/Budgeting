# Postgres (docker compose up -d) — or any Postgres connection string
DATABASE_URL=postgres://budget:budget@localhost:5432/budget

# Long random string used to sign session cookies
AUTH_SECRET=change-me-to-a-long-random-string

# Used by `npm run db:import` to seed from the 2026 finance workbook
BUDGET_2026_XLSX="Z:\Kaushal\MJNH\Budget 2026\Final Budget Files\H.E. MJN_Budget 2026.xlsm"
# ---- Azure (App Service settings; values in Key Vault) ----
# DATABASE_URL=postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/budget?sslmode=require
# NODE_ENV=production            (secure cookies, 60 s idle connections, change notices between instances)
# BUILD_STANDALONE=1             (build: self-contained server, started with `node server.js`)
# MIGRATE_ON_START=1             (apply the migrations when the app starts, from inside the private network)
# DB_POOL_MAX=10                 (connections per app instance; keep instances × this under the server's limit)
# DATA_CACHE=off                 (only to switch off the shared page cache, e.g. while investigating)

# Folder holding the PM templates (RERA Index Range sheets are read from these)
PM_TEMPLATES_DIR="Z:\Kaushal\MJNH\Budget 2026\Revenue\PMD 2026 JB\1. Revenue 2026"
